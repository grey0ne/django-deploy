{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deploy configuration",
  "type": "object",
  "properties": {
    "services": {
      "type": "object",
      "properties": {
        "celery": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "centrifugo": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "dev": {
      "type": "object",
      "properties": {
        "postgres": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "minio": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "django": {
      "type": "object",
      "properties": {
        "worker_count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
